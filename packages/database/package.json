{
  "name": "@struchkai/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:check": "node --env-file-if-exists=.env dist/migrate.js check",
    "db:migrate": "node --env-file-if-exists=.env dist/migrate.js apply",
    "db:seed": "node --env-file-if-exists=.env dist/seed.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "@struchkai/contracts": "0.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
